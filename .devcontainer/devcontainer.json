{
  "name": "Lab SDLC Seguro · OWASP RailsGoat",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "pip install --user semgrep==1.182.0 -r seguridad/fase-4/pruebas/requirements.txt",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "OWASP RailsGoat (puerto privado: no lo haga público)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hediet.vscode-drawio",
        "ms-python.python",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  }
}
