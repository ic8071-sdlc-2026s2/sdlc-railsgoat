# Datos de la app para lab/app.sh, los workflows y el verificador.
APP_NOMBRE="OWASP RailsGoat"
APP_PUERTO=3000
APP_RUTA_SALUD="/"
APP_RUTA_INICIAL=""
# Rails 8 bloquea en desarrollo los Host que no conoce: sin esto, el puerto reenviado por
# Codespaces (*.app.github.dev) responde 403 «Blocked host». Verificado con curl.
APP_DOCKER_ARGS=(-e RAILS_DEVELOPMENT_HOSTS=.app.github.dev)
APP_COMANDO=(bash -c "bundle exec rails db:setup && rm -f tmp/pids/server.pid && exec bundle exec rails s -p 3000 -b 0.0.0.0")
APP_IMAGEN_UPSTREAM=""
APP_ESPERA_SEGUNDOS=300
ZAP_MODO="baseline"
ZAP_OPENAPI=""
